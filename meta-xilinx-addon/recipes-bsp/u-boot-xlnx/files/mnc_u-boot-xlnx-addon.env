/*
 * Custom default U-Boot environment additions for MNCOS Xilinx targets.
 *
 * Wired in via CONFIG_ENV_SOURCE_FILE="mnc_u-boot-xlnx-addon" (see
 * modify_feature.cfg) and copied into the U-Boot tree at
 * board/xilinx/zynqmp/mnc_u-boot-xlnx-addon.env by the u-boot-xlnx bbappend.
 * U-Boot APPENDS these to the standard Xilinx ZynqMP environment rather than
 * replacing it: env_default.h concatenates CONFIG_EXTRA_ENV_TEXT (generated
 * from this file) after the board's CFG_EXTRA_ENV_SETTINGS.
 *
 * NOTE: this file is run through the C preprocessor, which does NOT strip
 * '#' comments here (assembler-with-cpp mode) -- use C-style comments only.
 *
 * tftpbootstep: one-shot TFTP netboot used during development. Loads the
 * kernel, device tree, ramdisk and boot script (the files exported by
 * export-tftpboot-file.bbclass) and boots. Run it at the U-Boot prompt with:
 *
 *     run tftpbootstep
 *
 * The JTAG loader writes MNCOS_JTAG_MAGIC to DDR before starting U-Boot.
 * CONFIG_PREBOOT consumes the marker, imports optional runtime IP overrides,
 * and starts tftpbootstep. Normal boots never set the marker.
 */
/* Retry whole network commands: the lwIP network stack ignores netretry. */
mncos_net_retry=setenv mncos_net_ok no; for mncos_net_attempt in 1 2 3 4 5; do if run ${mncos_net_command}; then setenv mncos_net_ok yes; break; fi; echo "MNCOS network attempt ${mncos_net_attempt}/5 failed: ${mncos_net_command}"; if test "${mncos_net_attempt}" != "5"; then sleep 1; fi; done; test "${mncos_net_ok}" = "yes"
mncos_tftp_image=tftpboot 0x00200000 Image
mncos_tftp_dtb=tftpboot 0x00100000 system.dtb
mncos_tftp_ramdisk=tftpboot 0x04000000 rootfs.cpio.gz.u-boot
mncos_tftp_script=tftpboot 0x20000000 boot.scr
mncos_load_image=setenv mncos_net_command mncos_tftp_image; run mncos_net_retry
mncos_load_dtb=setenv mncos_net_command mncos_tftp_dtb; run mncos_net_retry
mncos_load_ramdisk=setenv mncos_net_command mncos_tftp_ramdisk; run mncos_net_retry
mncos_load_script=setenv mncos_net_command mncos_tftp_script; run mncos_net_retry
/* A returned/failed JTAG boot must never enter media/PXE fallback. */
mncos_jtag_recovery=echo "MNCOS JTAG boot stopped; inspect network/artifacts and retry from the recovery prompt"; false
/* Run only the script's vendor setup, then boot the downloaded RAM root.
 * The minimal RAM root owns /init and switches to the immutable image itself.
 */
mncos_jtag_handoff=setenv boot_targets jtag; setenv devtype jtag; if source 0x20000000 && fdt addr 0x00100000; then setenv bootargs "earlycon console=ttyPS1,115200 init_fatal_sh=1 rdinit=/init ro mncos.tftp_server=${serverip}"; booti 0x00200000 0x04000000 0x00100000; else false; fi
tftpbootstep=setenv bootcmd 'run mncos_jtag_recovery'; setenv netretry no; if run mncos_load_image && run mncos_load_dtb && run mncos_load_ramdisk && run mncos_load_script; then run mncos_jtag_handoff; else echo "MNCOS JTAG required transfer failed; refusing to boot incomplete memory"; false; fi
mncos_jtag_use_dhcp=yes
/* Keep this block away from Xilinx scriptaddr=0x20000000 and the TFTP load addresses above. */
mncos_jtag_magic_addr=0x1ff00000
mncos_jtag_magic=0x4d4e4350
mncos_jtag_env_magic_addr=0x1ff00004
mncos_jtag_env_magic=0x49504f56
mncos_jtag_env_addr=0x1ff00100
mncos_jtag_env_size=0x100
mncos_jtag_import_env=if itest.l *${mncos_jtag_env_magic_addr} == ${mncos_jtag_env_magic}; then mw.l ${mncos_jtag_env_magic_addr} 0 1; env import -t ${mncos_jtag_env_addr} ${mncos_jtag_env_size} mncos_tftp_serverip ipaddr mncos_jtag_use_dhcp; fi
mncos_jtag_boot=setenv serverip ${mncos_tftp_serverip}; echo "MNCOS JTAG TFTP boot: ${ipaddr} -> ${serverip}"; run tftpbootstep
mncos_dhcp=dhcp
mncos_jtag_preboot=if itest.l *${mncos_jtag_magic_addr} == ${mncos_jtag_magic}; then mw.l ${mncos_jtag_magic_addr} 0 1; setenv bootcmd 'run mncos_jtag_recovery'; setenv netretry no; if run mncos_jtag_import_env && test -n "${mncos_tftp_serverip}"; then if test "${mncos_jtag_use_dhcp}" = "yes"; then setenv autoload no; setenv mncos_net_command mncos_dhcp; if run mncos_net_retry; then run mncos_jtag_boot; else echo "MNCOS JTAG DHCP failed; recovery prompt required"; false; fi; else run mncos_jtag_boot; fi; else echo "MNCOS JTAG TFTP server missing or environment import failed"; false; fi; fi
