[Unit]
Description=Recover MNC system transactions before platform services start
DefaultDependencies=no
Before=systemd-networkd.service systemd-tmpfiles-setup.service systemd-journal-flush.service

[Service]
Type=oneshot
RuntimeDirectory=mnc/system
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/mnc-system-manager --bootstrap
RemainAfterExit=yes
User=root
Group=root
UMask=0077
TimeoutStartSec=infinity
SyslogIdentifier=mnc-system-bootstrap

[Install]
WantedBy=sysinit.target
