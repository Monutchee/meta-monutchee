# Persistent backing inodes must retain their logical runtime-path labels.
/state/os/var-lib /var/lib
/state/os/machine-id /etc/machine-id
/state/os/ssh /etc/ssh
/state/os/root-ssh /home/root/.ssh
/data/log /var/log

# Persisted host keys use their canonical SSH configuration-path types.
/run/ssh /etc/ssh
# Immutable capture is another name for the same current-image policy inodes.
/run/mnc/selinux/store /var/lib/selinux
