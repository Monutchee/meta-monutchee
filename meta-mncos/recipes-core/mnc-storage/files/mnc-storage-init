#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Used by both disk-root init= and the RAM/SquashFS switch_root entry point.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mountpoint -q /run || mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
if ! /usr/sbin/mnc-storage prepare; then
    echo 'Storage preparation failed; refusing normal startup.' >/dev/console
    exec /bin/sh </dev/console >/dev/console 2>&1
fi
exec /sbin/init "$@"
