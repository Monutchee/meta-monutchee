# We have a conf and classes directory, add to BBPATH.
BBPATH .= ":${LAYERDIR}"
@@LAYER_VARIABLE@@_LAYERDIR := "${LAYERDIR}"

# We have recipes-* directories, add to BBFILES.
BBFILES += "${LAYERDIR}/recipes-*/*/*.bb \
            ${LAYERDIR}/recipes-*/*/*.bbappend"

BBFILE_COLLECTIONS += "meta-@@PRODUCT@@"
BBFILE_PATTERN_meta-@@PRODUCT@@ = "^${LAYERDIR}/"
BBFILE_PRIORITY_meta-@@PRODUCT@@ = "6"

LAYERDEPENDS_meta-@@PRODUCT@@ = " \
    core \
    mncos \
    xilinx-addon \
    zynqmp-addon \
    kria-addon \
    kria \
    xilinx \
    xilinx-standalone \
    "
LAYERSERIES_COMPAT_meta-@@PRODUCT@@ = "scarthgap"

PROJECT_NAME ?= "@@PRODUCT@@"

# Product cloud source used when APU_RPU_CTL_SRC is set to "cloud".
APU_RPU_CTL_REPO_cloud:pn-apu-rpu-ctl = "gitsm://github.com/Monutchee/@@PROJECT_PREFIX@@_APU.git;protocol=https;branch=${APU_RPU_CTL_GIT_BRANCH};name=apu-rpu-ctl;destsuffix=git"

require conf/kria-bootcmd-usb-rootfs-partuuid.inc
