_monutchee_setupsdk_usage() {
    cat <<'EOF'
Usage:
  source ./setupSDK [--product PRODUCT] [BUILD_DIR]

Products:
  zudemo       Use meta-zuboard/conf/templates/default and build
  kr260demo    Use meta-kr260demo/conf/templates/default and build
  msap1        Use meta-msap1/conf/templates/default and build

Other products use meta-<product>/conf/templates/default when that directory
exists and the product name contains only lowercase letters, digits, and
single hyphen separators.

Examples:
  source ./setupSDK --product zudemo
  source ./setupSDK --product kr260demo
  source ./setupSDK --product msap1 build
EOF
}

if [ -n "${BASH_SOURCE:-}" ]; then
    _monutchee_setupsdk_file="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_NAME:-}" ]; then
    _monutchee_setupsdk_file="$0"
else
    _monutchee_setupsdk_file="${PWD}/setupSDK"
fi

ROOT="$(readlink -f "$(dirname "${_monutchee_setupsdk_file}")")"

# Resolve the product from MONUTCHEE_PRODUCT or the per-workspace marker.
# An explicit --product argument overrides both. monutchee-manifest writes the
# marker once, so a bare `source ./setupSDK` selects the right product later.
_monutchee_product="${MONUTCHEE_PRODUCT:-}"
if [ -z "${_monutchee_product}" ] && [ -r "${ROOT}/.mncos-product" ]; then
    _monutchee_product="$(tr -d '[:space:]' < "${ROOT}/.mncos-product" 2>/dev/null)"
fi
_monutchee_build_dir=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --product)
            if [ "$#" -lt 2 ]; then
                printf 'Error: --product requires a product name.\n' >&2
                return 2 2>/dev/null || exit 2
            fi
            _monutchee_product="$2"
            shift 2
            ;;

        --product=*)
            _monutchee_product="${1#*=}"
            shift
            ;;

        -h|--help)
            _monutchee_setupsdk_usage
            return 0 2>/dev/null || exit 0
            ;;

        *)
            if [ -n "${_monutchee_build_dir}" ]; then
                printf 'Error: setupSDK accepts at most one build directory.\n' >&2
                return 2 2>/dev/null || exit 2
            fi
            _monutchee_build_dir="$1"
            shift
            ;;
    esac
done

case "${_monutchee_product}" in
    zudemo|zuboard)
        _monutchee_product="zudemo"
        _monutchee_template_layer="meta-zuboard"
        _monutchee_default_build_dir="build"
        ;;

    kr260demo|kr260)
        _monutchee_product="kr260demo"
        _monutchee_template_layer="meta-kr260demo"
        _monutchee_default_build_dir="build"
        ;;

    "")
        printf 'Error: no product selected.\n' >&2
        printf '  Pass --product <name>, export MONUTCHEE_PRODUCT, or create %s\n' \
            "${ROOT}/.mncos-product" >&2
        return 2 2>/dev/null || exit 2
        ;;

    *)
        case "${_monutchee_product}" in
            *[!a-z0-9-]*|-*|*--*|*-)
                printf 'Error: invalid product identifier: %s\n' \
                    "${_monutchee_product}" >&2
                return 2 2>/dev/null || exit 2
                ;;
        esac
        _monutchee_template_layer="meta-${_monutchee_product}"
        _monutchee_default_build_dir="build"
        if [ ! -d "${ROOT}/sources/meta-monutchee/${_monutchee_template_layer}/conf/templates/default" ]; then
            printf 'Error: unsupported product or missing build template: %s\n' \
                "${_monutchee_product}" >&2
            return 2 2>/dev/null || exit 2
        fi
        ;;
esac

if [ -z "${_monutchee_build_dir}" ]; then
    _monutchee_build_dir="${_monutchee_default_build_dir}"
fi

# Fail before changing the shell environment or creating build configuration.
if [ ! -f "${ROOT}/sources/openembedded-core/oe-init-build-env" ] || \
   [ ! -f "${ROOT}/sources/bitbake/bin/bitbake" ]; then
    printf 'Error: MNCOS requires sources/openembedded-core and sources/bitbake from the matching Yocto manifest.\n' >&2
    printf 'Synchronize the Yocto sources with setupWorkspace ... yocto first.\n' >&2
    return 1 2>/dev/null || exit 1
fi
case "${_monutchee_build_dir}" in
    /*) _monutchee_check_build_dir="${_monutchee_build_dir}" ;;
    *) _monutchee_check_build_dir="${PWD}/${_monutchee_build_dir}" ;;
esac
if [ -f "${_monutchee_check_build_dir}/conf/bblayers.conf" ] && \
   grep -v '^[[:space:]]*#' "${_monutchee_check_build_dir}/conf/bblayers.conf" | \
       grep -Eq '(^|[/[:space:]])(poky|meta-poky|meta-yocto-bsp)([/[:space:]"\\]|$)'; then
    printf 'Error: %s/conf/bblayers.conf still uses the former Poky layout.\n' "${_monutchee_check_build_dir}" >&2
    printf 'Move the old build directory aside, initialize a fresh one, and transfer reviewed local.conf settings.\n' >&2
    printf 'Regenerate machine configuration with the normal mnc mconf workflow; do not copy old bblayers.conf.\n' >&2
    return 1 2>/dev/null || exit 1
fi

# Monutchee Yocto template (per-product; lives in the board/product layer)
export MONUTCHEE_PRODUCT="${_monutchee_product}"
export TEMPLATECONF="${ROOT}/sources/meta-monutchee/${_monutchee_template_layer}/conf/templates/default"
export PATH="${PATH}:${ROOT}/scripts"

# Load the Xilinx gen-machine-conf helper.
if [ -d "${ROOT}/sources/meta-xilinx/meta-xilinx-core/gen-machine-conf" ]; then
    export PATH="${PATH}:${ROOT}/sources/meta-xilinx/meta-xilinx-core/gen-machine-conf"
fi

# Pass BitBake explicitly so a stale BITBAKEDIR in the shell cannot win.
source "${ROOT}/sources/openembedded-core/oe-init-build-env" \
    "${_monutchee_build_dir}" "${ROOT}/sources/bitbake"
