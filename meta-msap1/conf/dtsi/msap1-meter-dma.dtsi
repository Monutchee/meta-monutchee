/* MSAP1 Linux meter-result DMA ownership. */
&ADC_DMA_axi_dma_0 {
	clocks = <&zynqmp_clk 0x47>,
		 <&zynqmp_clk 0x47>,
		 <&zynqmp_clk 0x47>;
	clock-names = "m_axi_s2mm_aclk", "s_axi_lite_aclk", "m_axi_sg_aclk";
};

/* The S2MM interrupt is wired to pl_ps_irq0 GIC SPI 89. */
&dma_channel_b0030030 {
	interrupts = <0 89 4>;
};

/* SPI, capture, and metering configuration remain R5 core 0 owned. */
&AdcSubSystem_0_Ad7771Capture_Wrapper_0 {
	status = "disabled";
};

&AdcSubSystem_0_axi_quad_spi_0 {
	status = "disabled";
};

&AdcConversion_0_AdcConversion_Wrapper_0 {
	status = "disabled";
};

&MeterProcessing_0_VoltageRms_Wrapper_0 {
	status = "disabled";
};

/* Lopper extracts /amba_pl into the runtime overlay and renames it to &amba. */
&amba_pl {
	msap1_meter_dma: meter-acquisition {
		compatible = "monutchee,msap1-meter-dma";
		dmas = <&ADC_DMA_axi_dma_0 1>;
		dma-names = "rx";
		status = "okay";
	};
};
