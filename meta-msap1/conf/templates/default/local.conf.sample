# MSAP1 build bootstrap configuration.
# The hardware machine configuration is generated from the product XSA/SDT.
MACHINE ??= "qemuarm64"
DISTRO ?= "mncos"

# Build directly from the MSAP1_APU working tree, including uncommitted edits.
MSAP1_APU_APP_SRC = "local_inst"
MSAP1_APU_APP_GIT_BRANCH = "feat/add_adc_spi"
MSAP1_APU_APP_LOCAL_DIR = "${TOPDIR}/../../MSAP1_APU"

# Build the React/Vite UI from the live checkout, including uncommitted edits.
MSAP1_WEB_SRC = "local_inst"
MSAP1_WEB_GIT_BRANCH = "main"
MSAP1_WEB_LOCAL_DIR = "${TOPDIR}/../../MSAP1_WEB"

# Development-only restricted SSH account for testing the machine-readable
# mnc interface. Disabled by default and forbidden in production-flash builds.
# Login: debugai / debugai
MSAP1_ENABLE_DEBUGAI = "0"

# Load the PL application and both R5 firmwares at boot.
XILINX_DFX_AUTOLOAD = "1"

DL_DIR ?= "${TOPDIR}/../yocto-cache/downloads"
SSTATE_DIR ?= "${TOPDIR}/../yocto-cache/sstate-cache"

EXTRA_IMAGE_FEATURES ?= "debug-tweaks"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"

BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

PACKAGECONFIG:append:pn-qemu-system-native = " sdl"
