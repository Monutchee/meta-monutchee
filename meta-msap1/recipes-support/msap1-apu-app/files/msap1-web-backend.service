[Unit]
Description=MSAP1 authenticated web backend and nginx supervisor
Wants=msap1-settings.service msap1-fpga-acquisition.service msap1-meter-historian.service
After=network.target systemd-tmpfiles-setup.service msap1-settings.service msap1-meter-historian.service
Conflicts=nginx.service

[Service]
Type=notify
SyslogIdentifier=msap1-web-backend
LogExtraFields=MNC_COMPONENT=web-backend
StandardOutput=journal
StandardError=journal
NotifyAccess=main
WatchdogSec=20s
User=mnc-web
Group=mnc-settings
# The authenticated Developer log API reads the system journal through
# libsystemd. systemd-journal grants read-only journal access; mnc-data
# continues to grant access to acquisition IPC runtime objects.
SupplementaryGroups=mnc-web mnc-data systemd-journal
UMask=0007

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

Environment=MSAP1_WEB_SOCKET=/run/monutchee/web-backend.sock
Environment=MSAP1_WEB_HTTP_PORT=80
Environment=MSAP1_WEB_HTTPS_PORT=443
Environment=MSAP1_WEB_TLS_DIR=/var/lib/monutchee/tls
Environment=MSAP1_NGINX_CONFIG=/etc/monutchee/msap1/nginx.conf
Environment=MSAP1_NGINX_LISTEN_FILE=/run/monutchee/nginx/listen.conf
Environment=MSAP1_NGINX_PIDFILE=/run/monutchee/nginx/nginx.pid
Environment=MSAP1_NGINX_TEMP_ROOT=/run/monutchee/nginx

ExecStartPre=/usr/libexec/msap1-web-tls-setup
ExecStartPre=/bin/rm -f /run/monutchee/web-backend.sock /run/monutchee/nginx/nginx.pid
ExecStart=/usr/bin/msap1-web-backend
Restart=on-failure
RestartSec=2s
KillMode=control-group
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
