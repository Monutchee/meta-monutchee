[Unit]
Description=MSAP1 MQTT meter-data publisher
Requires=msap1-settings.service msap1-fpga-acquisition.service
After=network-online.target msap1-settings.service msap1-fpga-acquisition.service systemd-tmpfiles-setup.service
Wants=network-online.target

[Service]
Type=notify
SyslogIdentifier=msap1-mqtt-publisher
LogExtraFields=MNC_COMPONENT=mqtt-publisher
StandardOutput=journal
StandardError=journal
NotifyAccess=main
WatchdogSec=20s
User=mnc-mqtt
Group=mnc-data
SupplementaryGroups=mnc-settings
UMask=0077
ExecStart=/usr/bin/msap1-mqtt-publisher
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/run/monutchee/mqtt-publisher
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Deliberately no [Install] section. msap1-service-manager starts and stops
# this unit from the persisted MQTT enable setting.
