[Unit]
Description=MSAP1 bounded waveform format converter
After=data.mount systemd-tmpfiles-setup.service msap1-fpga-acquisition.service
RequiresMountsFor=/data/mnc/waveform /data/mnc/waveform-exports

[Service]
Type=notify
Nice=5
SyslogIdentifier=msap1-waveform-converter
LogExtraFields=MNC_COMPONENT=waveform-converter
StandardOutput=journal
StandardError=journal
NotifyAccess=main
WatchdogSec=20s
User=mnc-converter
# The primary web group makes the mode-0660 AF_UNIX endpoint available only
# to the authenticated web backend (plus root). mnc-data grants source reads.
Group=mnc-web
SupplementaryGroups=mnc-data mnc-converter
UMask=0077
ExecStart=/usr/bin/msap1-waveform-converter
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/data/mnc/waveform
ReadWritePaths=/data/mnc/waveform-exports /run/monutchee/waveform-converter
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
